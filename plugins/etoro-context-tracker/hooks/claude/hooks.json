{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/inject_banner.py\" claude || python \"${CLAUDE_PLUGIN_ROOT}/scripts/inject_banner.py\" claude",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/reset_baseline.py\" claude || python \"${CLAUDE_PLUGIN_ROOT}/scripts/reset_baseline.py\" claude",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
